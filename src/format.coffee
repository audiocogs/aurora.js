###*
 * Format contains metadata about an audio stream. It is
 * generated by the Demuxer, usually by reading file headers.
 *
 * @struct
###
class AV.Format
    ###*
     * @type {number}
    ###
    bitsPerChannel: undefined,

    ###*
     * @type {number}
    ###
    bytesPerFrame: undefined,

    ###*
     * @type {number}
    ###
    bytesPerPacket: undefined,

    ###*
     * @type {number}
    ###
    channelsPerFrame: undefined,

    ###*
     * True if samples are floating point values
     * @type {boolean}
    ###
    floatingPoint: undefined,

    ###*
     * Unique identifier for the file's stream format.
     * Helps to find a proper decoder.
     * @type {string}
    ###
    formatID: undefined,

    ###*
     * @type {number}
    ###
    framesPerPacket: undefined,

    ###*
     * True if samples are in little endian format
     * @type {boolean}
    ###
    littleEndian: undefined,

    ###*
     * @type {number}
    ###
    sampleCount: undefined,

    ###*
     * @type {number}
    ###
    sampleRate: undefined,

    # NOTE: this is only here to be backwards compatible. Make obsolete soon.
    constructor: ({@bitsPerChannel, @bytesPerFrame, @bytesPerPacket,
        @channelsPerFrame, @floatingPoint, @formatID, @framesPerPacket,
        @littleEndian, @sampleCount, @sampleRate}) ->

    ###*
     * @param  {!number} sample - Sample number in bytes
     * @return {!number} time - Time in milliseconds
    ###
    timeAtSample: (sample) ->
        (timestamp / 1000) * @sampleRate

    ###*
     * @param  {!number} time - Time in milliseconds
     * @return {!number} sample - Sample number in bytes
    ###
    sampleAtTime: (time) ->
        time / @sampleRate * 1000 | 0
